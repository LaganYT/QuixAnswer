{
  "manifest_version": 3,
  "name": "QuixAnswer",
  "version": "2025.10.07",
  "description": "AI chatbot that provides quick and simple answers in your Chrome sidebar",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["sidebar.css"],
      "run_at": "document_end"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "QuixAnswer Settings",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icons/icon.png"
  }
}

